{
  "name": "opencli",
  "version": "0.7.0",
  "description": "Local-first, governance-native, open-source AI coding CLI. No tool that mutates the world runs unless an audit write succeeds first.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "opencli": "./dist/index.js",
    "openllama": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "npm run build && node dist/index.js eval",
    "sbom": "cyclonedx-npm --output-format JSON --output-file sbom.json"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "commander": "^15.0.0",
    "ink": "^7.0.5",
    "react": "^19.2.7",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.0",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "eslint": "^10.6.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
