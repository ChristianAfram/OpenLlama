# OpenLlama environment overrides.
# Copy to `.env` for local use. These override the active profile at runtime.
# Never commit a real `.env` — it is gitignored and CI runs a secret scanner.

# Base URL of your local Ollama server.
OLLAMA_HOST=http://127.0.0.1:11434

# Default model to drive the agent (must be pulled in Ollama: `ollama pull <model>`).
OPENLLAMA_MODEL=qwen2.5-coder:7b
